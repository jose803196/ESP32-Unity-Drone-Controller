################################################################################
## .gitignore Óptimo para Proyecto Integrado (Unity, ESP-IDF, KiCad)         ##
################################################################################

# === ARCHIVOS DE CONFIGURACIÓN DE EDITORES E IDEs =============================
# Ignora configuraciones personales y caché de VS Code, Visual Studio, etc.
.vscode/
.vs/
.idea/
*.sln
*.csproj


# === SISTEMA OPERATIVO Y ARCHIVOS TEMPORALES ==================================
# Ignorar archivos temporales comunes y de caché de los sistemas operativos
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini


# === UNITY ====================================================================
# Estas carpetas son generadas localmente por Unity y pueden ser enormes.
# NUNCA deben estar en el repositorio.
# Explude all files from the `Library` folder except the file containing the package information
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Aa]ssets/AssetStoreTools*

# Autogenerated VS/MD solution and project files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj

# Unity3D generated meta files
*.pidb.meta

# Unity3D Generated File On Crash Reports
sysinfo.txt

# Builds
*.apk
*.unitypackage

# Carpeta Library, la más importante
Unity_Project/Library/

# Excluir algunos archivos de proyecto autogenerados por IDEs
Unity_Project/*.sln
Unity_Project/*.csproj
Unity_Project/*.unityproj


# === ESP-IDF (Firmware) =======================================================
# Estas reglas se aplicarán a AMBOS proyectos de firmware.
**/build/
**/.pio/
**/sdkconfig.old
**/sdkconfig.h


# === KICAD (Hardware) =========================================================
# Ignorar backups, configuraciones locales y salidas de fabricación.
# ¡NO ignorar los archivos de huellas (.kicad_mod) ni las librerías (.pretty)!

# Archivos de respaldo y caché
*-backups/
*.bak
*-cache.lib
*.kicad_prl
_autosave-*
fp-lib-cache

# Archivos de configuración de proyecto/sesión
*.kicad_pro

# Tabla de librerías de huellas (es local a cada ordenador)
fp-lib-table

# Salidas de fabricación (Gerbers, PDFs de ploteo, etc.)
gerbers/
plots/
*.gbr
*.drl
*.gbrjob


# === LaTeX (Documentación) ====================================================
# Archivos auxiliares generados durante la compilación.
*.aux
*.acn
*.acr
*.alg
*.glg
*.glo
*.gls
*.ist
*.fls
*.log
*.lof
*.lot
*.out
*.toc
*.bbl
*.blg
*.brf
*.fdb_latexmk
*.nav
*.snm
*.vrb
*.synctex.gz
_minted*
*.xdv


# === Blender & Archivos Comprimidos ===========================================
# Backups de Blender
*.blend1
*.blend2

# Backups temporales en formato comprimido
*.zip
*.rar
*.7z

UserSettings/Layouts/CurrentMaximizeLayout.dwlt
UserSettings/EditorUserSettings.asset
UserSettings/Layouts/*.dwltUserSettings/Layouts/CurrentMaximizeLayout.dwlt
